From 2e0c4bf40a9154b4eea5ff40a93c6a52b40975d3 Mon Sep 17 00:00:00 2001
From: bmh129 <11478682+bmh129@users.noreply.github.com>
Date: Tue, 20 Oct 2026 18:23:51 -0500
Subject: [PATCH 1/7] Linux: fall back to native Wayland when the X11 libraries
 are missing

The deb and rpm only recommend libX11 and friends, but the app forced the
X11 backend whenever DISPLAY was set (XWayland, for file drag-and-drop), so
a Wayland desktop without them (weak dependencies skipped, minimal or
atomic installs) failed to start. Check that winit's X11 libraries load
before choosing XWayland, and otherwise run natively on Wayland.

The rpm also never listed libX11-xcb, which winit opens and which Fedora
ships as its own package; add it to the recommendations.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Cargo.lock                 |  1 +
 apps/wordcraft/Cargo.toml  |  3 +++
 apps/wordcraft/src/main.rs | 19 +++++++++++++++++--
 packaging/linux/nfpm.yaml  |  4 +++-
 4 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 31028fe10a..65b6cffb6d 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -5159,6 +5159,7 @@ dependencies = [
  "wordcraft-fonts",
  "wordcraft-proof",
  "wordcraft-ui-egui",
+ "x11-dl",
  "zbus",
 ]
 
diff --git a/apps/wordcraft/Cargo.toml b/apps/wordcraft/Cargo.toml
index 40e0d7a9c1..f4fc5c3d97 100644
--- a/apps/wordcraft/Cargo.toml
+++ b/apps/wordcraft/Cargo.toml
@@ -50,6 +50,9 @@ dispatch2 = "0.3"
 
 [target.'cfg(all(unix, not(target_os = "macos")))'.dependencies]
 winit = { version = "0.30", default-features = false, features = ["x11"] }
+# Checks that the X11 libraries are installed before choosing XWayland (see main.rs). Already in
+# the build through winit, at this version.
+x11-dl = "2.21"
 # The desktop's animation setting on Linux and the BSDs, read from the XDG settings portal over
 # D-Bus. Already in the build through AccessKit, at this version; this adds only its blocking API.
 zbus = { version = "5", default-features = false, features = ["async-io", "blocking-api"] }
diff --git a/apps/wordcraft/src/main.rs b/apps/wordcraft/src/main.rs
index db5b2488ac..f3778068de 100644
--- a/apps/wordcraft/src/main.rs
+++ b/apps/wordcraft/src/main.rs
@@ -263,6 +263,20 @@ fn app_icon() -> Option<egui::IconData> {
     eframe::icon_data::from_png_bytes(png).map_err(|e| log::warn!("app icon: {e}")).ok()
 }
 
+/// Whether the libraries winit's X11 backend opens at startup are installed (libX11, libXcursor,
+/// libX11-xcb and libXi; libX11-xcb brings in libxcb). The deb and rpm only recommend them, and a
+/// forced X11 backend without them fails to start.
+#[cfg(all(unix, not(target_os = "macos")))]
+fn x11_libraries_load() -> bool {
+    use x11_dl::{xcursor::Xcursor, xinput2::XInput2, xlib::Xlib, xlib_xcb::Xlib_xcb};
+    let missing = [Xlib::open().err(), Xcursor::open().err(), Xlib_xcb::open().err(), XInput2::open().err()];
+    let missing: Vec<String> = missing.into_iter().flatten().map(|e| e.to_string()).collect();
+    if !missing.is_empty() {
+        log::warn!("X11 libraries missing, using the native Wayland backend: {}", missing.join("; "));
+    }
+    missing.is_empty()
+}
+
 const USAGE: &str = "\
 wordcraft — the WordCraft desktop app
 
@@ -400,8 +414,9 @@ fn main() -> eframe::Result {
     #[cfg(all(unix, not(target_os = "macos")))]
     // winit has no file drag-and-drop on Wayland (only on X11), so dropping files from the file
     // manager showed a "no" cursor. Run through XWayland when it's there; WORDCRAFT_WAYLAND=1
-    // keeps the native Wayland backend.
-    if std::env::var_os("DISPLAY").is_some() && std::env::var_os("WORDCRAFT_WAYLAND").is_none() {
+    // keeps the native Wayland backend. The X11 libraries are only recommended by the packages,
+    // so without them a Wayland desktop gets the native backend instead of a failed start.
+    if std::env::var_os("DISPLAY").is_some() && std::env::var_os("WORDCRAFT_WAYLAND").is_none() && x11_libraries_load() {
         options.event_loop_builder = Some(Box::new(|b| {
             use winit::platform::x11::EventLoopBuilderExtX11;
             b.with_x11();
diff --git a/packaging/linux/nfpm.yaml b/packaging/linux/nfpm.yaml
index bf75ccc1eb..9eb1e51706 100644
--- a/packaging/linux/nfpm.yaml
+++ b/packaging/linux/nfpm.yaml
@@ -24,7 +24,8 @@ description: |-
 
 # The binaries link only glibc and libgcc_s directly. Windowing (X11/Wayland, xkbcommon) and the
 # GPU (Vulkan, EGL/GL) are loaded at runtime, so they are dependencies/recommendations here
-# rather than ELF NEEDED entries.
+# rather than ELF NEEDED entries. Without the X11 libraries the app runs on native Wayland
+# (no file drag-and-drop there with winit 0.30), so they are recommendations.
 overrides:
   deb:
     depends:
@@ -48,6 +49,7 @@ overrides:
     recommends:
       - libwayland-client
       - libX11
+      - libX11-xcb
       - libXcursor
       - libXi
       - libXrandr

From f06b170c72e4b3db7cacc1ac898668cec3154b68 Mon Sep 17 00:00:00 2001
From: bmh129 <11478682+bmh129@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:10:32 -0500
Subject: [PATCH 2/7] Linux: default to the native Wayland backend;
 WORDCRAFT_X11=1 for XWayland

XWayland was the default on Wayland desktops only for file drag-and-drop,
which winit 0.30 supports on X11 alone (#220). It costs blurry or oversized
windows at fractional scales (#1382, #68), broken input methods over XIM
(#2932, #2933, #1169) and wrongly sized dialogs (#1240), and needs the X11
libraries installed. Let winit pick native Wayland, and make XWayland the
opt-in: WORDCRAFT_X11=1, still ignored when the X11 libraries are missing.
WORDCRAFT_WAYLAND=1 is now the default and has no effect.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 README.md                  | 11 ++++++-----
 apps/wordcraft/src/main.rs | 12 ++++++------
 packaging/linux/nfpm.yaml  |  4 ++--
 3 files changed, 14 insertions(+), 13 deletions(-)

diff --git a/README.md b/README.md
index cefca8f1ef..b2ebbc7543 100644
--- a/README.md
+++ b/README.md
@@ -278,13 +278,14 @@ adapter. The log file records the choice (lines starting with
 RISC-V (riscv64): `wordcraft-<ver>-linux-riscv64.tar.gz`, a tarball cross-compiled for glibc 2.39+
 (Ubuntu 24.04, Debian 13 and newer).
 
-**Wayland:** on a Wayland desktop the app runs through XWayland when it is available, because
-winit (the windowing library) supports dragging files into the window only on X11. To use the
-native Wayland backend instead (for example for sharper text with fractional scaling, at the cost
-of file drag-and-drop), start it with `WORDCRAFT_WAYLAND=1`:
+**Wayland:** on a Wayland desktop the app uses the native Wayland backend, which is sharp at
+fractional scales and works with input methods. winit (the windowing library) supports dragging
+files into the window only on X11, so to drop files from the file manager, run the app through
+XWayland with `WORDCRAFT_X11=1` (this needs the X11 libraries: libX11, libX11-xcb, libXcursor
+and libXi):
 
 ```sh
-WORDCRAFT_WAYLAND=1 wordcraft
+WORDCRAFT_X11=1 wordcraft
 ```
 
 **Arch Linux (AUR).** Community members maintain three AUR packages; the project doesn't publish
diff --git a/apps/wordcraft/src/main.rs b/apps/wordcraft/src/main.rs
index f3778068de..bcf72f6a4c 100644
--- a/apps/wordcraft/src/main.rs
+++ b/apps/wordcraft/src/main.rs
@@ -272,7 +272,7 @@ fn x11_libraries_load() -> bool {
     let missing = [Xlib::open().err(), Xcursor::open().err(), Xlib_xcb::open().err(), XInput2::open().err()];
     let missing: Vec<String> = missing.into_iter().flatten().map(|e| e.to_string()).collect();
     if !missing.is_empty() {
-        log::warn!("X11 libraries missing, using the native Wayland backend: {}", missing.join("; "));
+        log::warn!("WORDCRAFT_X11: X11 libraries missing, using the native Wayland backend: {}", missing.join("; "));
     }
     missing.is_empty()
 }
@@ -412,11 +412,11 @@ fn main() -> eframe::Result {
         options.viewport = window.apply(options.viewport);
     }
     #[cfg(all(unix, not(target_os = "macos")))]
-    // winit has no file drag-and-drop on Wayland (only on X11), so dropping files from the file
-    // manager showed a "no" cursor. Run through XWayland when it's there; WORDCRAFT_WAYLAND=1
-    // keeps the native Wayland backend. The X11 libraries are only recommended by the packages,
-    // so without them a Wayland desktop gets the native backend instead of a failed start.
-    if std::env::var_os("DISPLAY").is_some() && std::env::var_os("WORDCRAFT_WAYLAND").is_none() && x11_libraries_load() {
+    // winit runs natively on a Wayland desktop: sharp at fractional scales, with working input
+    // methods. It has no file drag-and-drop there (only on X11), so WORDCRAFT_X11=1 runs through
+    // XWayland instead for dropping files from the file manager (#220). The X11 libraries are only
+    // recommended by the packages, so without them the setting is ignored rather than failing.
+    if std::env::var_os("DISPLAY").is_some() && std::env::var_os("WORDCRAFT_X11").is_some() && x11_libraries_load() {
         options.event_loop_builder = Some(Box::new(|b| {
             use winit::platform::x11::EventLoopBuilderExtX11;
             b.with_x11();
diff --git a/packaging/linux/nfpm.yaml b/packaging/linux/nfpm.yaml
index 9eb1e51706..cd306b45b0 100644
--- a/packaging/linux/nfpm.yaml
+++ b/packaging/linux/nfpm.yaml
@@ -24,8 +24,8 @@ description: |-
 
 # The binaries link only glibc and libgcc_s directly. Windowing (X11/Wayland, xkbcommon) and the
 # GPU (Vulkan, EGL/GL) are loaded at runtime, so they are dependencies/recommendations here
-# rather than ELF NEEDED entries. Without the X11 libraries the app runs on native Wayland
