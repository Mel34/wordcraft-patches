From 380778d3fe01ecfa632d99f11e3c0f32dbef99db Mon Sep 17 00:00:00 2001
From: bmh129 <11478682+bmh129@users.noreply.github.com>
Date: Tue, 20 Oct 2026 20:52:27 -0500
Subject: [PATCH 4/7] Linux: check libxkbcommon-x11 before X11; WORDCRAFT_X11
 only when 1

winit's X11 backend also loads libxkbcommon-x11 (for the keyboard) and
panics when it is missing, so WORDCRAFT_X11=1 on a system without it
failed to start instead of staying on native Wayland. The library check
now includes it, through xkbcommon-dl's non-panicking loader (already in
the build through winit), and the deb and rpm recommend it
(libxkbcommon-x11-0, libxkbcommon-x11).

WORDCRAFT_X11 turned XWayland on whenever it was set, so 0 or an empty
value did too; only 1 does now, as documented.

Both found in review by CodeRabbit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Cargo.lock                 |  1 +
 README.md                  |  4 ++--
 apps/wordcraft/Cargo.toml  |  3 +++
 apps/wordcraft/src/main.rs | 17 +++++++++++------
 packaging/linux/nfpm.yaml  |  2 ++
 5 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 65b6cffb6d..b5614f95c7 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -5160,6 +5160,7 @@ dependencies = [
  "wordcraft-proof",
  "wordcraft-ui-egui",
  "x11-dl",
+ "xkbcommon-dl",
  "zbus",
 ]
 
diff --git a/README.md b/README.md
index b2ebbc7543..4b3dde5f2e 100644
--- a/README.md
+++ b/README.md
@@ -281,8 +281,8 @@ RISC-V (riscv64): `wordcraft-<ver>-linux-riscv64.tar.gz`, a tarball cross-compil
 **Wayland:** on a Wayland desktop the app uses the native Wayland backend, which is sharp at
 fractional scales and works with input methods. winit (the windowing library) supports dragging
 files into the window only on X11, so to drop files from the file manager, run the app through
-XWayland with `WORDCRAFT_X11=1` (this needs the X11 libraries: libX11, libX11-xcb, libXcursor
-and libXi):
+XWayland with `WORDCRAFT_X11=1` (this needs the X11 libraries: libX11, libX11-xcb, libXcursor,
+libXi and libxkbcommon-x11):
 
 ```sh
 WORDCRAFT_X11=1 wordcraft
diff --git a/apps/wordcraft/Cargo.toml b/apps/wordcraft/Cargo.toml
index f4fc5c3d97..4bf0a6d1f0 100644
--- a/apps/wordcraft/Cargo.toml
+++ b/apps/wordcraft/Cargo.toml
@@ -53,6 +53,9 @@ winit = { version = "0.30", default-features = false, features = ["x11"] }
 # Checks that the X11 libraries are installed before choosing XWayland (see main.rs). Already in
 # the build through winit, at this version.
 x11-dl = "2.21"
+# Checks for libxkbcommon-x11 too, which winit's X11 backend needs for the keyboard and panics
+# without. Already in the build through winit, at this version and with this feature.
+xkbcommon-dl = { version = "0.4.2", features = ["x11"] }
 # The desktop's animation setting on Linux and the BSDs, read from the XDG settings portal over
 # D-Bus. Already in the build through AccessKit, at this version; this adds only its blocking API.
 zbus = { version = "5", default-features = false, features = ["async-io", "blocking-api"] }
diff --git a/apps/wordcraft/src/main.rs b/apps/wordcraft/src/main.rs
index bcf72f6a4c..f903bfab26 100644
--- a/apps/wordcraft/src/main.rs
+++ b/apps/wordcraft/src/main.rs
@@ -264,13 +264,17 @@ fn app_icon() -> Option<egui::IconData> {
 }
 
 /// Whether the libraries winit's X11 backend opens at startup are installed (libX11, libXcursor,
-/// libX11-xcb and libXi; libX11-xcb brings in libxcb). The deb and rpm only recommend them, and a
